# Normalize line endings for everyone (macOS, Windows, Linux, cloud agents)
* text=auto eol=lf

# Lockfiles: don't hand-merge. On conflict, take main's copy and re-run `pnpm install` / `uv lock`.
pnpm-lock.yaml linguist-generated=true -diff
analysis/uv.lock linguist-generated=true -diff

# Golden fixtures are generated by `pnpm golden`; review the generator, not the JSON
fixtures/**/*.json linguist-generated=true

# Binary assets
*.glb binary
*.gltf binary
*.png binary
*.jpg binary
*.woff2 binary
